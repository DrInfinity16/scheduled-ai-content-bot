# --- Google Gemini (required) ---------------------------------
GEMINI_API_KEY=your-gemini-api-key
MODEL=gemini-3.5-flash-lite

# true  = simulate: nothing is published, the cycle ends at Status=Ready
# false = real publication on X (requires the X credentials below)
DRY_RUN=true

# Content source: auto (Notion when credentials exist) | notion | yaml
CONTENT_SOURCE=auto

# --- Notion editorial calendar --------------------------------
# Required when CONTENT_SOURCE=notion; leave both unset for yaml mode.
# Share the database with your Notion integration first.
NOTION_TOKEN=your-notion-token
NOTION_DATABASE_ID=your-notion-database-id

# Seconds between polling cycles (default: 60)
CONTENT_POLL_INTERVAL_SECONDS=60

# --- X / Twitter ----------------------------------------------
# Handle without "@" — only used to build the Published URL.
X_USERNAME=your_handle

# Only required when DRY_RUN=false.
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_SECRET=your-x-access-secret

# --- Durable technical state (SQLite) -------------------------
# Gitignored local file; never contains credentials.
DATABASE_PATH=content_bot.db

# --- Bounded retries (transient failures: network, 429/5xx) ---
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0

# --- Image generation (optional, only for Generate Image=true) -
# Provider: google | cloudflare (code default: google)
IMAGE_PROVIDER=cloudflare

# cloudflare: default is @cf/black-forest-labs/flux-1-schnell
# google:     required when an item requests an image (no default)
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Required when IMAGE_PROVIDER=cloudflare (Workers AI permissions).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Local directory for generated images (gitignored; never contains secrets).
IMAGE_OUTPUT_DIR=artifacts/images

# --- Optional paths -------------------------------------------
# CALENDAR_FILE=calendar.yaml
# LOG_FILE=log/posts.jsonl
